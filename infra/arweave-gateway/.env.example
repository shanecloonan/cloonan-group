# =============================================================================
# Self-hosted Arweave gateway — environment config
# Copy to `.env` on the server and fill in.
# =============================================================================

# --- Required ----------------------------------------------------------------

# Root hostname this gateway answers on. Everything under *.ARNS_ROOT_HOST is
# treated as a sandboxed ArNS subdomain. MUST have a wildcard DNS record.
#   Example:  gateway.cloonangroup.com
#   Wildcard: *.gateway.cloonangroup.com   -> same server
ARNS_ROOT_HOST=gateway.cloonangroup.com

# Email for Let's Encrypt / ACME registration (Caddy will auto-issue certs).
ACME_EMAIL=ops@cloonangroup.com

# Strong random string (32+ chars). Required to call /ar-io/admin/*.
#   openssl rand -hex 32
ADMIN_API_KEY=CHANGE_ME_TO_A_LONG_RANDOM_HEX_STRING

# --- Upstream / bootstrap ----------------------------------------------------

# Arweave L1 node used for bootstrapping. Peers will be discovered automatically.
# Can point at another gateway (arweave.net) or a raw L1 node.
TRUSTED_NODE_URL=https://arweave.net

# Gateway used to fetch data that isn't in your local cache yet.
# As your cache warms up, this is used less and less.
TRUSTED_GATEWAY_URL=https://arweave.net

# Template for ArNS resolution lookups before your node is fully synced.
# __NAME__ is replaced with the ArNS name.
TRUSTED_ARNS_GATEWAY_URL=https://__NAME__.arweave.net

# --- Sync depth --------------------------------------------------------------

# Height to start indexing from. Default 1407552 (~ early 2024) is plenty for
# most data you care about; lower = more historical coverage but slower sync.
# Set to 0 to sync the entire chain (takes days/weeks + lots of disk).
START_HEIGHT=1407552

# Highest block to index. "Infinity" = follow the tip forever.
STOP_HEIGHT=Infinity

# Whether to index ANS-104 data items (bundled transactions). Enabling this
# lets you serve bundled items directly instead of proxying. Uses more disk.
BACKFILL_BUNDLE_RECORDS=true
ANS104_UNBUNDLE_FILTER={"never": true}
ANS104_INDEX_FILTER={"never": true}

# --- Content policy ----------------------------------------------------------

# CENSORSHIP: leave empty to serve EVERYTHING. Set to
# https://arweave.net/ar-io/admin/block-list to honor the arweave.net block list.
ARNS_NAMES_BLACKLIST_URL=

# allow-all | block-all-then-allow-list | allow-all-then-block-list
CONTENT_MODERATION_MODE=allow-all

# --- Optional: ARIO observer / earning ---------------------------------------

# Arweave wallet address that owns this gateway (used for ARIO rewards).
AR_IO_WALLET=
OBSERVER_WALLET=

# --- Operational tuning ------------------------------------------------------

AR_IO_NODE_RELEASE=latest
LOG_LEVEL=info
LOG_FORMAT=simple
REDIS_MAX_MEMORY=2gb
