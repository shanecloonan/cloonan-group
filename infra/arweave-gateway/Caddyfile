# -----------------------------------------------------------------------------
# Caddy auto-TLS + reverse proxy config for the self-hosted ar.io gateway.
#
# Caddy issues and renews Let's Encrypt certs automatically.
# Wildcard is served from the same address so ArNS sandbox domains work.
# -----------------------------------------------------------------------------

{
    email {$ACME_EMAIL}
    # Uncomment to use Let's Encrypt staging while testing DNS/firewall:
    # acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

# Apex hostname (e.g. gateway.cloonangroup.com)
{$ARNS_ROOT_HOST} {
    encode zstd gzip

    # Security headers (keep lenient enough for permaweb apps to render)
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options    "nosniff"
        Referrer-Policy           "no-referrer-when-downgrade"
        -Server
    }

    # CORS: permit reads from any origin. Gateways are public infrastructure.
    @cors_preflight method OPTIONS
    respond @cors_preflight 204 {
        close
    }
    header Access-Control-Allow-Origin  "*"
    header Access-Control-Allow-Methods "GET, POST, HEAD, OPTIONS"
    header Access-Control-Allow-Headers "content-type, authorization, x-amz-date, x-api-key"

    # Protect admin API behind the ADMIN_API_KEY bearer header (enforced by core)
    reverse_proxy envoy:3000 {
        header_up Host              {host}
        header_up X-Real-IP         {remote}
        header_up X-Forwarded-For   {remote}
        header_up X-Forwarded-Proto {scheme}
    }
}

# Wildcard ArNS sandbox subdomains (e.g. ardrive.gateway.cloonangroup.com).
# Requires DNS wildcard (*.{$ARNS_ROOT_HOST}) + a wildcard cert.
# Caddy will request a wildcard cert via DNS-01; provide the provider token
# separately (e.g. Cloudflare, Route53) or switch to HTTP-01 per-name issuance.
*.{$ARNS_ROOT_HOST} {
    encode zstd gzip

    tls {
        # dns cloudflare {env.CF_API_TOKEN}   # <- enable once DNS provider is configured
        on_demand
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options    "nosniff"
        Access-Control-Allow-Origin  "*"
        Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
    }

    reverse_proxy envoy:3000 {
        header_up Host              {host}
        header_up X-Real-IP         {remote}
        header_up X-Forwarded-For   {remote}
        header_up X-Forwarded-Proto {scheme}
    }
}
