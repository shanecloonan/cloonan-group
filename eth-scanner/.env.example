# Ethereum-only invariant scanner — server-side / worker env.
# Copy to .env and fill in. Never commit real keys.

# Comma-separated Etherscan API keys (rotated; default 0.4s spacing).
ETHERSCAN_API_KEYS=
# ETH_SCANNER_ETHERSCAN_INTERVAL=0.4

# Cloonan-group Supabase (same project as the Next.js app).
SUPABASE_URL=https://xvjqxjakckkbfsdrntwk.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Optional read-only eth_getCode (never sends a transaction).
# ETH_RPC_URL=

# Force local work/ JSON store even if a service-role key is set.
# ETH_SCANNER_DRY_RUN=1
