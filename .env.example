# ─────────────────────────────────────────────────────────────────────────────
#  Cloonan Group / MoneyFund — local development config
# ─────────────────────────────────────────────────────────────────────────────
#
# Copy this file to `.env.local` and fill in the secret-looking values.
# Keys prefixed with NEXT_PUBLIC_ are exposed to the browser.

# ── Permawrite public testnet (/testnet) ────────────────────────────────────
# HTTP→TCP JSON-RPC proxy URL (POST one JSON-RPC object, get one response line).
# Leaves live tip/status offline when unset; join instructions still work.
# Public testnet observer (live): http://5.161.201.73:8787/rpc
# Also set in public/testnet/config.json as rpc_proxy_url (used when env unset).
# Local override: http://127.0.0.1:8787/rpc
NEXT_PUBLIC_MFND_RPC_PROXY_URL=http://5.161.201.73:8787/rpc

# ── Supabase (cloonan-group project) ────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xvjqxjakckkbfsdrntwk.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_ueSeIqXlxXHnPSh1H3yEiw_jtf8nu8a

# ── Supabase migration runner (npm run db:migrate) ──────────────────────────
# Generate a personal access token at https://supabase.com/dashboard/account/tokens
# NEVER commit the real token. Server-side use only — do NOT prefix with NEXT_PUBLIC_.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=xvjqxjakckkbfsdrntwk

# ── Arweave gateway (self-hosted ar.io node — see infra/arweave-gateway) ───
# Point this at your own ar.io node once it's running. Falls back to a pool
# of public gateways when this is empty or unreachable.
NEXT_PUBLIC_ARWEAVE_PRIMARY_GATEWAY=
ARWEAVE_GATEWAY_ADMIN_KEY=

# ── Casino: deployed CasinoVault.sol addresses (per chain) ─────────────────
# Once you deploy infra/contracts/ethereum/CasinoVault.sol on a network,
# put the deployed address here so /casino/wallet can route real deposits
# and withdrawals. Leave blank to keep that chain in "not configured" mode.
NEXT_PUBLIC_CASINO_VAULT_ETHEREUM_MAINNET=
NEXT_PUBLIC_CASINO_VAULT_ETHEREUM_BASE=
NEXT_PUBLIC_CASINO_VAULT_ETHEREUM_ARBITRUM=
NEXT_PUBLIC_CASINO_VAULT_ETHEREUM_SEPOLIA=

# Optional RPC URL overrides per chain. Leave blank to use sensible defaults
# (Cloudflare for mainnet, mainnet.base.org for Base, etc.).
NEXT_PUBLIC_CASINO_RPC_ETHEREUM_MAINNET=
NEXT_PUBLIC_CASINO_RPC_ETHEREUM_BASE=
NEXT_PUBLIC_CASINO_RPC_ETHEREUM_ARBITRUM=
NEXT_PUBLIC_CASINO_RPC_ETHEREUM_SEPOLIA=

# ── Casino operator key (server-side only — NEVER prefix with NEXT_PUBLIC_) ─
# 32-byte hex private key (0x + 64 hex chars). The address derived from
# this key MUST match the `operator` address on the deployed CasinoVault.
# When unset, /api/casino/withdraw-authorize falls back to a dev key and
# any vault that accepts it is by definition not in production.
#
# Generate one: `node -e "console.log(require('ethers').Wallet.createRandom().privateKey)"`
CASINO_OPERATOR_KEY=

# Bearer secret for operator indexer webhooks (deposit-credit / withdraw-debit)
CASINO_OPERATOR_SECRET=

# ── CasinoVault deploy (Foundry — server/local only) ───────────────────────
# Used by scripts/deploy-casino-vault.ps1 and forge script. Never commit keys.
DEPLOYER_KEY=
CASINO_VAULT_OWNER=
CASINO_VAULT_OPERATOR=

# Post-deploy: allowlist USDC on the vault (Sepolia Circle test USDC):
#   ALLOW_TOKEN=0x1c7D4B196Cb0C7B29D5Daedb9e2cCeDaD4d5D4f4
#   CASINO_VAULT=0x...  RPC_URL=https://rpc.sepolia.org
#   .\scripts\configure-casino-vault.ps1
# Manual ledger credit after a finalized deposit tx:
#   npx tsx scripts/credit-casino-deposit.ts --user-id <uuid> --chain ethereum-sepolia --tx 0x... --wallet 0x...
